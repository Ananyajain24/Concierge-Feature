DATABASE_URL=postgres://lohono:lohono@localhost:5432/lohono
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Which LLM backs itinerary generation — the only switch you need to flip.
# Set to "anthropic" or "gemini". Only the matching API key below is required.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-5

# Get a key at https://aistudio.google.com/apikey
# GEMINI_MODEL accepts any Gemini model name, e.g.:
#   gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

TOKEN_SECRET=change-me-in-prod
NODE_ENV=development
